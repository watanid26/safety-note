# ── 데이터베이스 (LawChange 와 같은 Supabase 프로젝트) ─────────────────
# 앱 실행용: Transaction pooler (6543 포트). LawChange 의 DATABASE_URL 과 같은 값을 쓰면 된다.
#   끝에 ?pgbouncer=true 같은 Prisma 전용 옵션이 붙어 있으면 지운다.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require"
# 마이그레이션용: Direct connection (5432 포트). LawChange 의 DIRECT_URL 과 같은 값.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# ── 로그인 (LawChange 와 같은 Supabase Auth) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# 증빙 파일 저장(서버 전용, 절대 브라우저에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_EVIDENCE_BUCKET="safety-evidence"

# ── 법령 변경 데이터 (LawChange 가 수집한 public 스키마를 읽기만 함) ──
LAW_DATA_SCHEMA="public"
# 법령 변경을 눌렀을 때 열 LawChange 주소 (없으면 법제처 원문으로 연결)
LAWCHANGE_URL="https://lawchange 운영 주소"

# ── 사이트 · 메일 · 크론 ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://점검노트 도메인"
EMAIL_FROM="중대재해 점검노트 <no-reply@도메인>"
RESEND_API_KEY=""
# Vercel Cron 인증 (아무 긴 무작위 문자열)
CRON_SECRET=""

# ── 로컬 개발 전용 ───────────────────────────────────────────────────
# 1 이면 Supabase 없이 이메일만 넣고 들어가는 개발용 로그인이 /login 에 나타난다. 운영에서는 무시됨.
DEV_LOGIN_ENABLED=0
